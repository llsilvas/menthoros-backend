# ========================================
# MENTHOROS - ENVIRONMENT VARIABLES
# ========================================
# Copie este arquivo para .env e configure as variáveis

# ========================================
# KEYCLOAK ADMIN CREDENTIALS
# ========================================
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin123

# ========================================
# KEYCLOAK — VALIDACAO DO TOKEN (resource server)
# ========================================
# ARMADILHA: sao DUAS variaveis independentes. O Spring NAO deriva o jwk-set-uri
# a partir do issuer-uri quando ele esta configurado explicitamente — definir so
# uma faz a outra cair no default localhost:9999, onde nao ha nada.
#
# O sintoma nao aponta para a causa: todo request autenticado morre com
# "An error occurred while attempting to decode the Jwt", que sugere token
# invalido, quando o problema e o backend nao alcancar as chaves.
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/menthoros
KEYCLOAK_JWK_URI=http://localhost:8080/realms/menthoros/protocol/openid-connect/certs

# ========================================
# KEYCLOAK — ADMIN API (provisionamento)
# ========================================
# Usada pelo gateway que cria organization/usuario no auto-cadastro.
# Em ambiente com Keycloak remoto, apontar para o host real (ex.: HomeLab).
KEYCLOAK_SERVER_URL=http://localhost:8080

# ========================================
# KEYCLOAK HOSTNAME
# ========================================
# Para desenvolvimento local, use localhost
# Para produção, use o domínio real (ex: auth.menthoros.com)
KC_HOSTNAME=localhost

# ========================================
# KEYCLOAK LOG LEVEL
# ========================================
# Valores: info, debug, warn, error
KC_LOG_LEVEL=info

# ========================================
# OPENAI API KEY
# ========================================
# Obtenha sua chave em https://platform.openai.com/api-keys
OPENAI_API_KEY=sua_api_key_aqui

# ========================================
# DATABASE CONFIGURATION (OPCIONAL)
# ========================================
# Use apenas se diferentes do padrão
# POSTGRES_DB=menthoros-multi
# POSTGRES_USER=menthoros
# POSTGRES_PASSWORD=menthoros123

# ========================================
# REDIS CONFIGURATION (OPCIONAL)
# ========================================
# REDIS_HOST=redis
# REDIS_PORT=6379

# ========================================
# CORS CONFIGURATION (OPCIONAL)
# ========================================
# Origens permitidas para CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Métodos HTTP permitidos
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS

# Headers permitidos
CORS_ALLOWED_HEADERS=*

# Permitir credenciais (cookies, authorization headers)
CORS_ALLOW_CREDENTIALS=true

# ========================================
# JVM SETTINGS (PRODUÇÃO)
# ========================================
JAVA_OPTS_PROD=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+UseG1GC

# ========================================
# STRAVA INTEGRATION
# ========================================
# Obtenha em https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_REDIRECT_URI=http://localhost:8080/api/strava/callback
# Token aleatório para validação de webhook (defina você mesmo)
STRAVA_WEBHOOK_TOKEN=your_random_webhook_verify_token
# Dias de histórico a importar no sync inicial (padrão: 90)
STRAVA_SYNC_DAYS_BACK=90

# ========================================
# ENVIRONMENT
# ========================================
ENVIRONMENT=local

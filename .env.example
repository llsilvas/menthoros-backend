# Configurações da aplicação Menthoros
# Copie este arquivo para .env e ajuste os valores

# OpenAI API
OPENAI_API_KEY=sua_api_key_aqui

# Database (opcional - usar apenas se diferentes do padrão)
# POSTGRES_DB=menthoros
# POSTGRES_USER=menthoros  
# POSTGRES_PASSWORD=menthoros123

# Redis (opcional)
# REDIS_HOST=redis
# REDIS_PORT=6379

# JVM Settings (produção)
JAVA_OPTS_PROD=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+UseG1GC

# Ambiente específico
ENVIRONMENT=local
# ========================================
# MENTHOROS - ENVIRONMENT VARIABLES
# ========================================
# Copie este arquivo para .env e configure as variáveis

# ========================================
# KEYCLOAK ADMIN CREDENTIALS
# ========================================
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin123

# ========================================
# KEYCLOAK HOSTNAME
# ========================================
# Para desenvolvimento local, use localhost
# Para produção, use o domínio real (ex: auth.menthoros.com)
KC_HOSTNAME=localhost

# ========================================
# KEYCLOAK LOG LEVEL
# ========================================
# Valores: info, debug, warn, error
KC_LOG_LEVEL=info

# ========================================
# OPENAI API KEY
# ========================================
# Obtenha sua chave em https://platform.openai.com/api-keys
OPENAI_API_KEY=sua_api_key_aqui

# ========================================
# DATABASE CONFIGURATION (OPCIONAL)
# ========================================
# Use apenas se diferentes do padrão
# POSTGRES_DB=menthoros-multi
# POSTGRES_USER=menthoros
# POSTGRES_PASSWORD=menthoros123

# ========================================
# REDIS CONFIGURATION (OPCIONAL)
# ========================================
# REDIS_HOST=redis
# REDIS_PORT=6379

# ========================================
# CORS CONFIGURATION (OPCIONAL)
# ========================================
# Origens permitidas para CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Métodos HTTP permitidos
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS

# Headers permitidos
CORS_ALLOWED_HEADERS=*

# Permitir credenciais (cookies, authorization headers)
CORS_ALLOW_CREDENTIALS=true

# ========================================
# JVM SETTINGS (PRODUÇÃO)
# ========================================
JAVA_OPTS_PROD=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+UseG1GC

# ========================================
# ENVIRONMENT
# ========================================
ENVIRONMENT=local